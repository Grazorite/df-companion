{
  "name": "df-companion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc -b && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "tsx --test --test-concurrency=1 tests/ui/*.test.ts",
    "test:ui:smoke": "tsx --test tests/ui/smoke.test.ts",
    "lint": "oxlint",
    "format": "prettier --write src/",
    "preview": "vite preview",
    "validate": "node scripts/validate-badges.mjs && node scripts/validate-pets.mjs && node scripts/validate-accessories.mjs && node scripts/validate-weapons.mjs && node scripts/validate-housing.mjs && node scripts/validate-class-abilities.mjs && node scripts/validate-search-index.mjs && npm run verify && npm run typecheck:scripts",
    "verify": "node scripts/verify-datasets.mjs",
    "generate:badge-relations": "node scripts/generate-badge-relations.mjs",
    "generate:search-index": "tsx scripts/generate-search-index.ts",
    "generate:class-artifact-relations": "tsx scripts/generate-class-artifact-relations.ts",
    "generate:class-armor-relations": "tsx scripts/generate-class-armor-relations.ts",
    "generate:class-default-weapon-relations": "tsx scripts/generate-class-default-weapon-relations.ts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "scrape:badges": "tsx scripts/scrape-badges.ts",
    "scrape:pets": "tsx scripts/scrape-pets.ts",
    "scrape:guests": "tsx scripts/scrape-guests.ts",
    "scrape:accessories": "tsx scripts/scrape-accessories.ts",
    "scrape:weapons": "tsx scripts/scrape-weapons.ts",
    "scrape:housing": "tsx scripts/scrape-housing.ts",
    "scrape:classes": "tsx scripts/scrape-classes.ts",
    "clear:pets": "echo '[]' > src/data/pets.json && rm -f src/data/pets-progress.json && echo 'Cleared pets.json and progress'",
    "clear:guests": "echo '[]' > src/data/guests.json && rm -f src/data/guests-progress.json && echo 'Cleared guests.json and progress'",
    "clear:all": "npm run clear:pets && npm run clear:guests && echo 'All data cleared'"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@vercel/speed-insights": "^2.0.0",
    "cmdk": "1.1.1",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "playwright": "^1.62.0",
    "prettier": "^3.9.1",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
}
